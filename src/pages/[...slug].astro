---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SubPage from '../layouts/SubPage.astro';
import CardArrow from '../components/CardArrow.astro';
import { pages, crumbsFor, siblingsOf, shortName, noBreak, faqFor, type Page } from '../data/pages';
import LegalReview from '../components/LegalReview.astro';
import { practice } from '../data/site';
import team from '../assets/physiotherapie-team-berlin-moabit.webp';
import monika from '../assets/monika-wellenbrock.webp';
import sina from '../assets/sina-wernecken.webp';
import monikaRound from '../assets/monika-portrait-rund.webp';
import IconPhysio from '../assets/icons/physiotherapie.svg?raw';
import IconOsteo from '../assets/icons/osteopathie.svg?raw';
import IconHome from '../assets/icons/hausbesuche.svg?raw';
import IconAccess from '../assets/icons/barrierefrei.svg?raw';
import { appointmentHref } from '../data/site';

export function getStaticPaths() {
  return pages
    // Impressum und Datenschutz sind eigene, von Hand gepflegte Seiten
    .filter((p) => p.kind !== 'special' && p.kind !== 'legal')
    .map((p) => ({ params: { slug: p.path.replace(/^\/|\/$/g, '') }, props: { page: p } }));
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const crumbs = crumbsFor(page);
const isLegal = page.kind === 'legal';
const siblings = page.kind === 'treatment' ? siblingsOf(page.path) : [];

// Bereich „Über uns“: Hero ohne Buttons
const aboutPages = ['/haltung/', '/team/', '/jobs/'];

// Leistungsseiten: ein Button „<Leistung> anfragen“, der das Terminformular vorausfüllt
const isService = ['treatment', 'overview'].includes(page.kind) || page.path === '/hausbesuche/';
const serviceName = page.path === '/hausbesuche/' ? 'Hausbesuch' : shortName(page.h1).replace(/\s+in\s+Moabit$/, '');
const heroService = isService
  ? { label: `${serviceName} anfragen`, href: `${appointmentHref}?leistung=${encodeURIComponent(page.path)}` }
  : undefined;

const cardIcon = (title: string) =>
  title === 'Physiotherapie' ? IconPhysio : title === 'Osteopathie' ? IconOsteo : undefined;

const isTeamImage = (src: string) => /team/.test(src);

// Teamseite: Porträts zu den Abschnitten, Name jeweils unter dem Bild
const portraits: Record<string, { img: ImageMetadata; name: string }> = {
  'Kompetenz aus Erfahrung': { img: monika, name: 'Monika Wellenbrock' },
  'Zukunft in guten Händen': { img: sina, name: 'Sina Wernecken' },
};

// Porträts für die Unterschrift unter persönlichen Texten (z. B. Osteopathie), schon rund freigestellt
const bylinePhotos: Record<string, ImageMetadata> = {
  'Monika Wellenbrock': monikaRound,
};

const faqs = faqFor(page);

// Antworttext sicher ausgeben und den Verweis auf die Preisseite verlinken
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const linkify = (s: string) =>
  escape(s).replace('Preise &amp; Kostenerstattung', '<a href="/preise/">Preise &amp; Kostenerstattung</a>');

const faqSchema = faqs.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ]
  : [];

const schema =
  page.kind === 'treatment'
    ? [
        ...faqSchema,
        {
          '@context': 'https://schema.org',
          '@type': 'Service',
          name: shortName(page.h1),
          serviceType: shortName(page.h1),
          description: page.description,
          url: new URL(page.path, practice.url + '/').href,
          provider: { '@id': `${practice.url}/#praxis` },
          areaServed: practice.areaServed.map((name) => ({ '@type': 'Place', name: `${name}, Berlin` })),
        },
      ]
    : [];
---

<SubPage
  title={page.title}
  description={page.description}
  h1={page.h1}
  lead={page.lead}
  crumbs={crumbs}
  schema={schema}
  heroActions={!isLegal && !aboutPages.includes(page.path)}
  heroService={heroService}
  cta={!isLegal}
>
  <div class:list={['sections', `kind-${page.kind}`]}>
    {
      page.sections.map((s) => {
        const tiles = page.kind === 'overview' && s.cards.length > 0;
        const columns = /^Wobei hilft/.test(s.heading);
        const portrait = page.path === '/team/' ? portraits[s.heading] : undefined;
        // Bild ohne Überschrift: Text darunter als Bildunterschrift (z. B. Namen im Teamfoto)
        const captioned = !s.heading && s.images.length > 0;
        return (
          <section class="block" id={s.id}>
            {portrait ? (
              <div class="container portrait">
                <figure>
                  <Image src={portrait.img} alt={`${portrait.name}, Physiotherapie Wellenbrock & Wernecken in Berlin-Moabit`} widths={[480, 720, 1080]} sizes="(max-width: 880px) 100vw, 540px" />
                  <figcaption>{portrait.name}</figcaption>
                </figure>
                <div class="portrait-text">
                  <h2 class="section-heading">{noBreak(s.heading)}</h2>
                  <div class="prose" set:html={s.html} />
                </div>
              </div>
            ) : captioned ? (
              <figure class="container media captioned">
                <Image src={team} alt={s.images[0].alt || 'Das Team der Physiotherapie Wellenbrock & Wernecken in Berlin-Moabit'} widths={[640, 1024, 1440, 2300]} sizes="(max-width: 1200px) 100vw, 1150px" />
                <figcaption class="prose" set:html={s.html} />
              </figure>
            ) : s.byline ? (
              <div class="narrow">
                <div class="card person">
                  <h2 class="section-heading">{noBreak(s.heading)}</h2>
                  <div class="prose" set:html={s.html} />
                  {/* Unterschrift mit rundem Porträt */}
                  <p class="byline">
                    {bylinePhotos[s.byline] && (
                      <Image class="byline-photo" src={bylinePhotos[s.byline]} alt="" widths={[72, 144]} sizes="72px" />
                    )}
                    <span>{s.byline}</span>
                  </p>
                </div>
              </div>
            ) : (
              <>
                {(s.heading || s.html) && (
                  <div class={tiles ? 'container overview-intro' : 'narrow'}>
                    {s.heading && <h2 class="section-heading">{noBreak(s.heading)}</h2>}
                    {s.html && <div class:list={['prose', { 'prose--columns': columns }]} set:html={s.html} />}
                    {s.id === 'neuro' && (
                      <a class="text-link" href="/physiotherapie/neurologische-physiotherapie/">
                        Mehr über neurologische Physiotherapie
                      </a>
                    )}
                  </div>
                )}

                {s.images.map((img) =>
                  isTeamImage(img.src) ? (
                    <div class="container media">
                      <Image src={team} alt={img.alt || 'Das Team der Physiotherapie Wellenbrock & Wernecken in Berlin-Moabit'} widths={[640, 1024, 1440]} sizes="(max-width: 1200px) 100vw, 1168px" />
                    </div>
                  ) : (
                    <div class="container media placeholder" role="img" aria-label={img.alt || 'Bild folgt'}>
                      Bild folgt
                    </div>
                  ),
                )}

                {s.buttons.length > 0 && (
                  <div class="narrow buttons">
                    {s.buttons.map((b) => (
                      <a class="btn btn--pink" href={b.href}>
                        {b.text}
                      </a>
                    ))}
                  </div>
                )}

                {tiles && (
                  <ul class="container service-list">
                    {s.cards.map((c) => (
                      <li>
                        <a href={c.href}>
                          <span>{noBreak(c.title)}</span>
                          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {!tiles && s.cards.length > 0 && (
                  <div class:list={[s.cards.length > 1 && !isLegal ? 'container card-grid' : 'narrow card-stack']}>
                    {s.cards.map((c) =>
                      isLegal ? (
                        <div class="legal-sub">
                          <h3>{noBreak(c.title)}</h3>
                          <div class="prose" set:html={c.html} />
                        </div>
                      ) : (
                        <div class:list={['card', 'info', c.variant && `info--${c.variant}`, { 'card--link': c.buttons.length > 0 }]}>
                          {c.variant === 'hausbesuche' && <span class="icon" set:html={IconHome} />}
                          {c.variant === 'barrierefrei' && (
                            <span class="icon icon--access" aria-hidden="true" set:html={IconAccess} />
                          )}
                          {cardIcon(c.title) && <span class="icon" set:html={cardIcon(c.title)} />}
                          <div class="info-body">
                            <h3>{noBreak(c.title)}</h3>
                            {c.html && <div class="prose" set:html={c.html} />}
                            {c.buttons[0] && <CardArrow href={c.buttons[0].href} label={`Mehr erfahren: ${c.buttons[0].text}`} />}
                          </div>
                        </div>
                      ),
                    )}
                  </div>
                )}
              </>
            )}
          </section>
        );
      })
    }

    {
      faqs.length > 0 && (
        <section class="block" aria-labelledby="fragen-behandlung">
          <div class="narrow">
            <h2 id="fragen-behandlung" class="section-heading">
              Häufige Fragen zu {noBreak(shortName(page.h1))}
            </h2>
            <LegalReview kind="content">
              Neue Fragen und Antworten, zusammengestellt aus den Angaben dieser Seite. Bitte fachlich prüfen.
            </LegalReview>
            <div class="faq">
              {faqs.map((f) => (
                <details>
                  <summary>
                    <span>{f.q}</span>
                    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                      <path d="M4 7l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2.2" />
                    </svg>
                  </summary>
                  <p set:html={linkify(f.a)} />
                </details>
              ))}
            </div>
            <a class="btn btn--pink all-questions" href="/haeufige-fragen/">Alle Fragen</a>
          </div>
        </section>
      )
    }

    {
      siblings.length > 0 && (
        <section class="block" aria-labelledby="weitere">
          <div class="narrow">
            <h2 id="weitere" class="section-heading">
              Weitere {page.path.startsWith('/osteopathie/') ? 'osteopathische' : 'physiotherapeutische'} Behandlungen in unserer
              Praxis in Moabit
            </h2>
            <ul class="sibling-list">
              {siblings.map((p) => (
                <li>
                  <a href={p.path}>{shortName(p.h1)}</a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </div>
</SubPage>

<style>
  .block {
    padding-block: clamp(32px, 4vw, 48px);
  }

  .block:first-child {
    padding-top: 0;
  }

  .narrow {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* Listen „Wobei hilft …“ zweispaltig */
  /* Zwei Textspalten statt Raster: Punkte laufen lückenlos untereinander, auch bei unterschiedlicher Länge */
  .prose--columns :global(ul) {
    display: block;
    columns: 2;
    column-gap: 2rem;
  }

  .prose--columns :global(li) {
    break-inside: avoid;
    margin-bottom: 0.6rem;
  }

  .media {
    margin-top: 1.5rem;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  figure {
    margin-block: 0;
  }

  .portrait figure {
    margin-inline: 0;
  }

  .captioned figcaption,
  .portrait figcaption {
    margin-top: 1rem;
    text-align: center;
  }

  /* Porträts auf der Teamseite: Bild mit Namen darunter, Text daneben */
  .portrait {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem 4rem;
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .portrait figcaption {
    font-family: var(--f-serif);
    font-size: var(--fs-lead);
  }

  .portrait-text {
    display: grid;
    gap: 1.25rem;
  }

  /* zweites Porträt gespiegelt */
  .block:nth-of-type(odd) .portrait figure {
    order: 2;
  }

  @media (max-width: 880px) {
    .portrait {
      grid-template-columns: 1fr;
    }

    .block:nth-of-type(odd) .portrait figure {
      order: 0;
    }
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--c-pink-soft);
    border-radius: var(--radius);
    font-weight: 600;
  }

  /* Leistungsliste der Übersichtsseiten (Physiotherapie, Osteopathie) */
  /* Überschrift und Einleitung gleich breit (nicht volle Seitenbreite) */
  .overview-intro {
    display: grid;
    gap: 1.5rem;
  }

  .overview-intro > * {
    max-width: 720px;
  }

  .overview-intro .section-heading {
    font-size: var(--fs-xl);
  }

  /* Leistungsliste innerhalb der Seitenbreite: Text bündig mit der Linie, Pfeil eingerückt */
  .service-list {
    margin-block: 1.5rem 0;
    padding: 0;
    list-style: none;
  }

  .service-list li {
    border-bottom: 1px solid var(--c-line);
  }

  .service-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2.25rem 1.75rem 2.25rem 0;
    font-family: var(--f-serif);
    font-weight: 500;
    font-size: var(--fs-lg);
    line-height: var(--lh-heading);
    text-decoration: none;
  }

  /* Hover: zartes Rosa, ragt links etwas über die Textkante hinaus */
  .service-list a {
    position: relative;
    isolation: isolate;
  }

  .service-list a::before {
    content: '';
    position: absolute;
    inset: 0 0 0 -1.25rem;
    z-index: -1;
    background: var(--c-pink-soft);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .service-list a:hover::before,
  .service-list a:focus-visible::before {
    opacity: 1;
  }

  .service-list svg {
    flex: none;
    width: 32px;
    height: 32px;
    color: var(--c-brand);
    transition: transform 0.15s ease;
  }

  .service-list a:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .service-list a {
      padding-block: 1.5rem;
      padding-right: 0.25rem;
    }
  }

  /* Infokarten (Barrierefreiheit, Hausbesuche, Angebote) */
  .card-stack {
    margin-top: 1.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 1.5rem;
    max-width: 984px;
  }

  .info {
    display: grid;
    align-items: start;
    align-content: start;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem 2rem;
    width: 100%;
    padding: 32px;
  }

  .info:not(:has(.icon)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .info .icon {
    width: 80px;
  }

  .icon--access {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c-pink-soft);
  }

  .icon--access :global(svg) {
    width: 44px;
    height: auto;
  }

  .info-body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
  }

  .info h3 {
    font-size: var(--fs-md);
    line-height: var(--lh-title);
  }

  /* Gründerin auf der Osteopathie-Seite */
  .person {
    display: grid;
    gap: 1.25rem;
    padding: clamp(28px, 4vw, 48px);
  }

  /* Unterschrift: rundes Porträt, daneben der Name in Serif */
  .byline {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
    font-family: var(--f-serif);
    font-size: var(--fs-lead);
    color: var(--c-ink);
  }

  .byline :global(.byline-photo) {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
  }

  /* Rechtstexte */
  .kind-legal .section-heading {
    font-size: var(--fs-lg);
  }

  .legal-sub {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .legal-sub h3 {
    font-size: var(--fs-md);
  }

  .kind-legal .prose {
    overflow-wrap: anywhere;
  }

  /* Häufige Fragen pro Behandlung */
  .faq {
    width: 100%;
  }

  .faq details {
    border-bottom: 1px solid var(--c-line);
  }

  .faq details:first-child {
    border-top: 1px solid var(--c-line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
    font-size: var(--fs-lead);
    line-height: var(--lh-title);
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary svg {
    flex: none;
    transition: transform 0.15s ease;
  }

  .faq details[open] summary svg {
    transform: rotate(180deg);
  }

  .faq details p {
    padding-bottom: 1.5rem;
    max-width: 40em;
  }

  .all-questions {
    margin-top: 1.25rem;
  }

  /* Interne Verlinkung */
  .sibling-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    width: 100%;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .sibling-list li {
    border-bottom: 1px solid var(--c-line);
  }

  .sibling-list a {
    display: block;
    padding: 0.9rem 0;
    font-weight: 600;
    text-decoration: none;
  }

  .sibling-list a:hover {
    color: var(--c-brand);
  }

  @media (max-width: 960px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .sibling-list,
    .prose--columns :global(ul) {
      columns: 1;
    }

    .info {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    /* Icon-Kreise auf dem Handy etwas kleiner */
    .info .icon {
      width: 64px;
    }

    .info .icon :global(svg) {
      height: auto;
    }

    .icon--access :global(svg) {
      width: 34px;
    }
  }
</style>
