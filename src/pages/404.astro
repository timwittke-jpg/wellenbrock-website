---
import Base from '../layouts/Base.astro';
import { practice, appointmentHref } from '../data/site';

const links = [
  { label: 'Physiotherapie', href: '/physiotherapie/' },
  { label: 'Osteopathie', href: '/osteopathie/' },
  { label: 'Hausbesuche', href: '/hausbesuche/' },
  { label: 'Preise', href: '/preise/' },
  { label: 'Häufige Fragen', href: '/haeufige-fragen/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<Base title="Seite nicht gefunden | Wellenbrock & Wernecken" description="Diese Seite gibt es nicht. Hier findest du den Weg zurück zu unserer Praxis für Physiotherapie und Osteopathie in Berlin Moabit." noindex>
  <section class="notfound container">
    <p class="code">404</p>
    <h1>Diese Seite gibt es leider nicht.</h1>
    <p class="lead">
      Vielleicht hat sich die Adresse geändert, oder ein Link ist veraltet. Hier geht es weiter – oder ruf uns einfach
      an: <a class="plain-link" href={practice.phoneHref}>{practice.phoneDisplay}</a>.
    </p>
    <div class="actions">
      <a class="btn btn--pink" href="/">Zur Startseite</a>
      <a class="btn btn--secondary" href={appointmentHref}>Termin vereinbaren</a>
    </div>
    <ul class="links">
      {links.map((l) => <li><a class="text-link" href={l.href}>{l.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding-block: clamp(64px, 10vw, 140px);
    text-align: center;
  }

  .code {
    font-family: var(--f-serif);
    font-size: var(--fs-xxl);
    color: var(--c-brand);
  }

  h1 {
    max-width: 18ch;
  }

  .lead {
    max-width: 34em;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
