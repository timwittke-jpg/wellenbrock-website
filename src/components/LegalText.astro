---
// Gemeinsame Typografie für Impressum und Datenschutz
---

<article class="narrow legal prose">
  <slot />
</article>

<style>
  .legal {
    padding-bottom: clamp(80px, 10vw, 140px);
    overflow-wrap: anywhere;
  }

  .legal :global(h2) {
    margin-top: 3rem;
    font-size: var(--fs-lg);
    line-height: var(--lh-heading);
  }

  .legal :global(h2:first-child) {
    margin-top: 0;
  }

  .legal :global(h3) {
    margin-top: 2rem;
    font-size: var(--fs-md);
    line-height: var(--lh-title);
  }

  .legal :global(h4) {
    margin-top: 1.5rem;
    font-family: var(--f-sans);
    font-size: var(--fs-body);
    font-weight: 600;
  }
</style>
