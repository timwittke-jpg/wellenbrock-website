---
// Offene Stellen auf der Jobs-Seite (aus dem CMS). Jede Stelle verlinkt auf ihre Unterseite;
// darunter immer die Einladung zur Initiativbewerbung.
import { noBreak } from '../data/pages';
import { activeJobs, jobHref, employmentText } from '../data/stellen';

interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<div class="narrow jobs">
  {
    activeJobs.length > 0 ? (
      <>
        <h2 class="section-heading">{noBreak(heading)}</h2>
        <ul class="job-list">
          {activeJobs.map((job) => (
            <li>
              <h3>{noBreak(job.title)}</h3>
              {job.employmentType.length > 0 && <p class="meta">{employmentText(job)} · Berlin-Moabit</p>}
              <a class="btn btn--pink" href={jobHref(job)}>
                Stelle ansehen
              </a>
            </li>
          ))}
        </ul>
        <div class="initiative">
          <h3>Nichts Passendes dabei?</h3>
          <p>Wir freuen uns auch über deine Initiativbewerbung – ein Anschreiben brauchst du nicht.</p>
          <a class="btn btn--secondary" href="/jobs/bewerben/?stelle=Initiativbewerbung">
            Initiativ bewerben
          </a>
        </div>
      </>
    ) : (
      <>
        <h2 class="section-heading">Initiativ bewerben</h2>
        <p>
          Gerade ist keine Stelle ausgeschrieben. Wir freuen uns trotzdem, von dir zu hören – ein Anschreiben brauchst du
          nicht.
        </p>
        <a class="btn btn--pink" href="/jobs/bewerben/?stelle=Initiativbewerbung">
          Initiativ bewerben
        </a>
      </>
    )
  }
</div>

<style>
  .jobs {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .job-list {
    display: grid;
    gap: 2rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .job-list li {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--c-line);
  }

  h3 {
    font-size: var(--fs-md);
    line-height: var(--lh-title);
  }

  .meta {
    color: #5f5a56;
  }

  .initiative {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .job-list .btn,
  .initiative .btn,
  .jobs > .btn {
    margin-top: 0.5rem;
  }
</style>
