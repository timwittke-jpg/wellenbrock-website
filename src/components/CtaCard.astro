---
import LogoMark from '../assets/icons/icon-cta.svg?raw';
import CardArrow from './CardArrow.astro';
import { appointmentHref } from '../data/site';
---

<section class="cta container" aria-labelledby="termin">
  <div class="card card--link cta-card">
    <div class="cta-inner">
      <span class="cta-mark" set:html={LogoMark} />
      <h2 id="termin">Jetzt Termin vereinbaren</h2>
      <p>
        Vereinbare jetzt deinen Termin in unserer Praxis in Berlin-Moabit.{' '}<br />Wir freuen uns auf dich!
      </p>
      <CardArrow href={appointmentHref} label="Termin vereinbaren" />
    </div>
  </div>
</section>

<style>
  .cta {
    max-width: 984px;
    padding-block: clamp(80px, 10vw, 140px);
  }

  /* Ganz klickbare weiße Karte wie die übrigen Karten, Logozeichen in Magenta; Hover: Schatten */
  .cta-card {
    padding: clamp(40px, 5vw, 56px) 24px;
    text-align: center;
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    width: min(100%, 36em);
    margin-inline: auto;
  }

  .cta-mark {
    width: clamp(72px, 7vw, 90px);
  }

  .cta-mark :global(svg) {
    width: 100%;
    height: auto;
  }

  /* Überschrift darf breiter laufen als der Text darunter */
  h2 {
    width: max-content;
    max-width: min(100vw - 2 * var(--gutter) - 48px, 900px);
    /* wie die Abschnittsüberschriften (H2): Cooper Medium, 56px */
    font-size: var(--fs-xxl);
  }

  p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Pfeil rechtsbündig unter dem Text */
  .cta-inner :global(.card-arrow) {
    justify-self: end;
    padding-top: 0.5rem;
  }

  @media (max-width: 560px) {
    p br {
      display: none;
    }  }
</style>
