---
// Hinweis „Aktuell“ und darunter „Wir stellen ein: Jetzt bewerben!“ mit Link zur Jobs-Seite (Startseite, Team).
// Erscheint nur, solange im CMS mindestens eine Stelle aktiv ist.
import { activeJobs } from '../data/stellen';
---

{
  activeJobs.length > 0 && (
    <p class="hiring">
      <span class="badge">Aktuell</span>
      <span>
        Wir stellen ein: <a href="/jobs/">Jetzt bewerben!</a>
      </span>
    </p>
  )
}

<style>
  /* Badge über dem Text; links bündig, im zentrierten Seitenkopf (Team) mittig */
  .hiring {
    display: flex;
    flex-direction: column;
    align-items: var(--hiring-align, flex-start);
    gap: 0.5rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* wie „Aktuell“ im Menü: hell Peach hinterlegt, 14px */
  .badge {
    padding: 0.05em 0.3em;
    border-radius: 4px;
    background: var(--c-peach-soft);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  /* Link ohne die Hinterlegung der Fließtext-Links, fett und unterstrichen */
  .hiring a {
    padding: 0;
    background: none;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hiring a:hover {
    text-decoration-thickness: 2px;
  }
</style>
