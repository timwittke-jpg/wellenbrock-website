---
// Hinweis „Aktuell – 1 offene Stelle: Jetzt bewerben“ mit Link zur Jobs-Seite (Startseite, Team).
// Die Zahl zählt die aktiven Stellen im CMS; ohne aktive Stelle erscheint nichts.
import { activeJobs, openPositionsText } from '../data/stellen';
---

{
  activeJobs.length > 0 && (
    <p class="hiring">
      <span class="badge">Aktuell</span>
      <span>
        {openPositionsText()}: <a href="/jobs/">Jetzt bewerben</a>
      </span>
    </p>
  )
}

<style>
  .hiring {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 8px;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* wie die Links im Fließtext: hell Peach hinterlegt */
  .badge {
    padding: 0.05em 0.3em;
    border-radius: 4px;
    background: var(--c-peach-soft);
    font-weight: 600;
  }

  /* Link ohne die Hinterlegung der Fließtext-Links, fett und unterstrichen */
  .hiring a {
    padding: 0;
    background: none;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hiring a:hover {
    text-decoration-thickness: 2px;
  }
</style>
